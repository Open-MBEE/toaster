// kind: tree
// stated: no view declared; rendering ToasterDemo::Toaster directly
// layout: dot
digraph {
  graph [fontname="Helvetica"];
  node [shape=box, style=filled, fillcolor=white, color="#181818", fontname="Helvetica", fontsize=14, penwidth=0.5];
  edge [color="#181818", fontname="Helvetica", fontsize=13, penwidth=1];
  "n0" [label=<<b>Toaster</b><br/><font point-size="10"><i>«part def»</i></font>>];
  "n1" [style="rounded,filled", label=<<b>cycleTime : DurationValue</b><br/><font point-size="10"><i>«attribute»</i></font>>];
  "n0" -> "n1" [arrowhead=none];
  "n2" [style="rounded,filled", label=<<b>heating : HeatingSystem</b><br/><font point-size="10"><i>«part»</i></font>>];
  "n0" -> "n2" [arrowhead=none];
  "n3" [style="rounded,filled", label=<<b>control : ControlSystem</b><br/><font point-size="10"><i>«part»</i></font>>];
  "n0" -> "n3" [arrowhead=none];
  "n4" [style="rounded,filled", label=<<b>durationInterface</b><br/><font point-size="10"><i>«interface»</i></font>>];
  "n0" -> "n4" [arrowhead=none];
}
